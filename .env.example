DEBUG=true
SECRET_KEY=dev-only-insecure-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Postgres in Docker: user=root password=root1234 db=hospital_erp
DATABASE_URL=postgres://root:root1234@localhost:5432/hospital_erp

